@page "/carousels"

<section aria-labelledby="carousels-heading">
    <h1 id="carousels-heading">Carousel Component</h1>
    <p>Cycle through arbitrary content using Bootstrap's Carousel plugin and Blazorade's component API.</p>

    <Carousel>
        <CarouselItem>
            <div class="d-flex align-items-center justify-content-center bg-primary text-white" style="height: 240px;">
                <strong>The simplest useful carousel slide</strong>
            </div>
        </CarouselItem>
    </Carousel>

    <section aria-labelledby="carousel-options-heading" class="mt-5">
        <h2 id="carousel-options-heading">Controls, indicators, and captions</h2>
        <Carousel ShowControls="true" ShowIndicators="true" Interval="4000" ActiveIndex="1">
            <CarouselItem CaptionHeading="First slide" CaptionBody="Slides can contain arbitrary Razor content.">
                <div class="d-flex align-items-center justify-content-center bg-secondary text-white" style="height: 240px;">First slide</div>
            </CarouselItem>
            <CarouselItem CaptionHeading="Second slide" CaptionBody="Controls and indicators are generated by the component.">
                <div class="d-flex align-items-center justify-content-center bg-success text-white" style="height: 240px;">Second slide</div>
            </CarouselItem>
            <CarouselItem CaptionHeading="Third slide" CaptionBody="The default interval is 5000 milliseconds.">
                <div class="d-flex align-items-center justify-content-center bg-danger text-white" style="height: 240px;">Third slide</div>
            </CarouselItem>
        </Carousel>
    </section>

    <section aria-labelledby="carousel-images-heading" class="mt-5">
        <h2 id="carousel-images-heading">Image slides</h2>
        <Carousel ShowControls="true" TransitionType="CarouselTransitionType.Fade">
            <CarouselItem ImageUrl="https://images.unsplash.com/photo-1519608487953-e999c86e7455?auto=format&amp;fit=crop&amp;w=1200&amp;q=80"
                          ImageAlt="Snowy mountain landscape" />
            <CarouselItem ImageUrl="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&amp;fit=crop&amp;w=1200&amp;q=80"
                          ImageAlt="Mountain valley under a blue sky" />
        </Carousel>
    </section>
</section>
